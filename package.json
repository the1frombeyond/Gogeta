{
  "name": "gogeta-cli-cc",
  "version": "3.1.3",
  "description": "GOGETA CLI - The ultimate AI-powered development platform. Now 100000000000000000000000000000000000000x more powerful.",
  "main": "dist/index.js",
  "bin": {
    "gogeta-cli-cc": "dist/index.js",
    "gogeta": "dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "commands",
    "agents",
    "hooks",
    "scripts",
    "sdk/dist",
    "sdk/prompts",
    "assets",
    "gogeta-cli",
    "Skills"
  ],
  "keywords": [
    "gogeta",
    "gogeta-cli",
    "ai",
    "cli",
    "autonomous-agents",
    "quantum-engine",
    "voice-to-code",
    "visual-builder",
    "game-dev",
    "web3",
    "blockchain",
    "devops",
    "mlops"
  ],
  "author": "TÂCHES",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the1frombeyond/Gogeta.git"
  },
  "homepage": "https://github.com/the1frombeyond/Gogeta#readme",
  "bugs": {
    "url": "https://github.com/the1frombeyond/Gogeta/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vitest": "^3.1.1"
  },
  "overrides": {
    "@anthropic-ai/sdk": "0.92.0"
  },
  "scripts": {
    "build:hooks": "node scripts/build-hooks.js",
    "build:sdk": "cd sdk && npm ci && npm run build",
    "build": "npm run build:hooks && npm run build:sdk",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && node -e \"require('fs').chmodSync('bin/install.js', '755')\"",
    "pretest": "npm run build:sdk",
    "test": "node scripts/run-tests.cjs",
    "test:coverage": "c8 node scripts/run-tests.cjs",
    "test:unit": "vitest --project=unit",
    "test:integration": "vitest --project=integration"
  }
}


